rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth & Role Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'mpgbsim.cemerlang@gmail.com';
    }

    function isAuthorizedAdmin() {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 1. Admins Collection
    // Only super admin can grant or modify admin privileges; authorized admins can read
    match /admins/{adminId} {
      allow read: if isAuthorizedAdmin();
      allow write: if isSuperAdmin();
    }

    // 2. Users Collection (Profile & Role Management)
    // User can only create or edit their own profile; admins can manage and delete
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAuthorizedAdmin());
      allow delete: if isAuthorizedAdmin();
    }

    // 3. Member Schools Directory
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if true;
    }

    // Leadership Collection (Barisan Kepimpinan PGB Kebangsaan)
    match /leadership/{leaderId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Events / Program Management
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // 5b. Event Registrations (Pendaftaran Peserta Acara)
    match /eventRegistrations/{regId} {
      allow read, write: if true;
    }

    // 6. Documents Centre
    match /documents/{documentId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. Best Practices Hub
    match /bestPractices/{practiceId} {
      allow read: if true;
      allow write: if true;
    }

    // 8. Member Submissions & Feedback (Contact messages, school submissions)
    match /submissions/{submissionId} {
      allow create, read, update, delete: if true;
    }

    // 9. Resource Centre
    match /resources/{resourceId} {
      allow read: if true;
      allow write: if true;
    }

    // 10. In-App Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // 11. Audit Logs (Immutable audit trail)
    match /auditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // 12. Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // 13. News & School Achievements
    match /news/{newsId} {
      allow read: if true;
      allow write: if true;
    }

    // 14. Media Gallery
    match /media/{mediaId} {
      allow read: if true;
      allow write: if true;
    }

    // 15. Site Settings (CMS Content)
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // 16. Member Applications (School Registration)
    match /memberApplications/{applicationId} {
      allow read, write: if true;
    }

    // 17. Alumni PGB MPGBSIM
    match /alumni/{alumniId} {
      allow read, write: if true;
    }

    // 18. Connection validation test path
    match /test/{testId} {
      allow read: if true;
    }
  }
}
